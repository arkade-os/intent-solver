{
  "name": "intent-solver",
  "license": "MIT",
  "version": "0.7.1",
  "private": true,
  "description": "Swap provider for Lightning <-> Arkade swaps",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.6.0 <27",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "start": "node --enable-source-maps --experimental-eventsource packages/solver-app/dist/cli.js watch",
    "cli": "pnpm build && node --enable-source-maps --experimental-eventsource packages/solver-app/dist/cli.js",
    "test": "vitest run --exclude e2e",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "format": "prettier --write test packages",
    "format:check": "prettier --check test packages",
    "gen:config-schema": "node scripts/gen-config-schema.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.5.14-taxi.1",
    "@arkade-taxi/client": "1.1.2",
    "@hono/node-server": "^2.1.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.0.0",
    "@scure/bip39": "^2.2.0",
    "@scure/btc-signer": "2.4.1",
    "@arkade-os/solver-arkade": "workspace:*",
    "@arkade-os/solver-core": "workspace:*",
    "@arkade-os/solver-corridors": "workspace:*",
    "@arkade-os/solver-corridors-evm": "workspace:*",
    "@arkade-os/solver-db": "workspace:*",
    "@arkade-os/solver-rails": "workspace:*",
    "@arkade-os/solver-rails-esplora": "workspace:*",
    "@arkade-os/solver-rails-evm": "workspace:*",
    "@arkade-os/solver-rails-fake": "workspace:*",
    "@arkade-os/solver-rails-lnd": "workspace:*",
    "@arkade-os/solver-transport": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.0",
    "light-bolt11-decoder": "^3.2.0",
    "lightning": "^12.2.3",
    "nostr-tools": "2.24.1"
  },
  "devDependencies": {
    "@arkade-os/solver-discovery": "0.3.0",
    "@arkade-os/swap": "0.1.16-taxi.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.21.2",
    "@foundry-rs/anvil": "1.7.1",
    "solc": "0.8.30",
    "zod-to-json-schema": "^3.25.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs",
      "@foundry-rs/anvil"
    ],
    "overrides": {
      "@arkade-os/sdk": "file:packages/solver-app/vendor/carrier/arkade-os-sdk-0.5.14-taxi.1-7584c23c.tgz",
      "@arkade-os/swap": "file:packages/solver-app/vendor/carrier/arkade-os-swap-0.1.16-taxi.1-7584c23c.tgz",
      "@arkade-taxi/client": "file:packages/solver-app/vendor/carrier/arkade-taxi-client-1.1.2-1e831e7d.tgz",
      "@arkade-taxi/covenant": "file:packages/solver-app/vendor/carrier/arkade-taxi-covenant-1.1.2-1e831e7d.tgz",
      "@arkade-taxi/protocol": "file:packages/solver-app/vendor/carrier/arkade-taxi-protocol-1.1.2-1e831e7d.tgz"
    }
  }
}
