{
  "name": "intent-solver",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "Swap provider for Lightning <-> Arkade swaps",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.6.0 <27",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.examples.json",
    "start": "node --enable-source-maps --experimental-eventsource --env-file=.env packages/solver-app/dist/cli.js watch",
    "cli": "pnpm build && node --enable-source-maps --experimental-eventsource --env-file=.env packages/solver-app/dist/cli.js",
    "test": "vitest run --exclude e2e",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "format": "prettier --write test packages",
    "format:check": "prettier --check test packages",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.4.67",
    "@hono/node-server": "^2.1.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@scure/btc-signer": "^2.0.1",
    "@arkade-os/solver-arkade": "workspace:*",
    "@arkade-os/solver-core": "workspace:*",
    "@arkade-os/solver-corridors": "workspace:*",
    "@arkade-os/solver-corridors-evm": "workspace:*",
    "@arkade-os/solver-db": "workspace:*",
    "@arkade-os/solver-rails": "workspace:*",
    "@arkade-os/solver-rails-esplora": "workspace:*",
    "@arkade-os/solver-rails-evm": "workspace:*",
    "@arkade-os/solver-rails-fake": "workspace:*",
    "@arkade-os/solver-rails-lnd": "workspace:*",
    "@arkade-os/solver-transport": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.0",
    "light-bolt11-decoder": "^3.2.0",
    "lightning": "^12.2.3",
    "nostr-tools": "^2.24.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@arkade-os/swap": "0.0.10",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.21.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  }
}
