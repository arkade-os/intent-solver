# Mutinynet on a real LND node — the shape a hosted deployment wants.
#
# The other examples in this repo are all regtest. This one is for a solver
# that faces an actual network, so it differs in what it CANNOT default: every
# endpoint below is somebody's real service, and the repo deliberately names
# none of them for you except the hosted Arkade Service itself.

SWAP_NETWORK=mutinynet

# Pins `minCheckpointExitDelaySeconds: 4096` for you, and that is not a knob.
# The hosted Service advertises 4096s, but the SDK cannot tell mutinynet from
# signet — byte-identical `Network` structs — so it applies the 86400s
# mainnet-grade floor and `Wallet.create` refuses to connect at all. Setting
# SWAP_NETWORK=mutinynet is the whole fix; there is nothing else to configure.

# ─── Required. Startup throws by name without each of these. ─────────────────

# Secret. Never logged, and the root of every key this solver holds.
ARK_MNEMONIC="<generate with any bip39 tool>"

# The hosted mutinynet Arkade Service. Startup refuses a server whose reported
# network disagrees with SWAP_NETWORK rather than quoting against the wrong
# chain.
ARK_SERVER_URL=https://mutinynet.arkade.sh

# YOURS TO SUPPLY, and there is no default on any network. The emulator
# co-signs the spends that move money, so a URL baked into this repository
# would point your deployment's money path at whoever that default named.
EMULATOR_URL=

LN_BACKEND=lnd
LND_SOCKET=<your-lnd-host>:10009

# ─── LND credentials: EXACTLY ONE of each pair ───────────────────────────────
#
# Both set, or neither, is an error — silently preferring one is how a stale
# file ships the wrong cert. On a CD platform prefer the inline base64 forms:
# they need no volume mount.
#
#   LND_CERT=<base64 of tls.cert>
#   LND_MACAROON=<base64 of admin.macaroon>
#
# base64 -w0 tls.cert   /   base64 -w0 admin.macaroon
LND_CERT=
LND_MACAROON=

# ─── Two explorers, and you want both ────────────────────────────────────────
#
# Different chains, watched by different clients, each with its own default.
#
# The Lightning side: LND's chain view is wallet-scoped and carries no
# per-output values, so it cannot see a client's funding transaction. The
# onchain-receive corridor fails loudly without this.
LND_ESPLORA_URL=https://mempool.mutinynet.arkade.sh/api
# The Arkade wallet's own view of L1. Unset takes the SDK's per-network
# default, and the failure is QUIET: one "Failed to fetch chain tip;
# height-based expiry will not be evaluated" at startup, then a process that
# looks healthy while block-denominated VTXO expiry goes unwatched.
ARK_ESPLORA_URL=https://mempool.mutinynet.arkade.sh/api

# ─── Mode: pick one, they are alternatives ───────────────────────────────────
#
# The image's default is `relay` — purely outbound, opens no port, needs
# RELAY_URL. `serve` is the HTTP host and needs HOST/PORT; it does NOT
# subscribe to a relay, and `relay` has no listening swap port.
#
# RELAY_URL is still worth setting under `serve`: it is what the registry card
# advertises, and what the admin console posts an ad to.
RELAY_URL=
# Only for `serve`. HOST must be 0.0.0.0 in a container — it binds loopback
# otherwise and the published port answers nothing.
# HOST=0.0.0.0
# PORT=8787

# ─── Storage. Point these at a persistent volume. ────────────────────────────
#
# SWAP_DB_PATH is THE file to back up: a funded script whose row is lost is
# unclaimable and unrefundable by us.
DB_DIR=/data

# ─── Admin console. Off unless ADMIN_PORT is set. ────────────────────────────
# THERE IS NO AUTH ON THIS PORT — anything that reaches it can move money.
# Keep the loopback bind and tunnel in; see docs/runbook.md.
# ADMIN_PORT=8788
# ADMIN_HOST=127.0.0.1
