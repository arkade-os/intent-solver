{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Cleared for the same reason every sibling package clears it: at emit time
    // a dependency must resolve through its `exports` map to dist/, or its
    // sources are pulled into THIS program and land outside rootDir.
    "paths": {},
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "noEmit": false,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
