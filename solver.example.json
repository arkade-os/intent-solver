{
  "$schema": "./solver-config.schema.json",
  "network": "bitcoin",
  "name": "my-solver",
  "rails": {
    "arkade": {
      "mnemonic": "<12 or 24 words: this wallet holds the float>",
      "serverUrl": "https://arkade.computer",
      "emulatorUrl": "https://emulator.example.com",
      "esploraUrl": "https://mempool.arkade.sh/api",
      "unilateralExitDelay": 260096,
      "covclaimdUrl": "https://covclaimd.example.com",
      "poolAutoMint": false,
      "contractRetentionDays": 30
    },
    "lightning": {
      "backend": "lnd",
      "lnd": {
        "socket": "lnd:10009",
        "certPath": "/secrets/tls.cert",
        "macaroonPath": "/secrets/admin.macaroon"
      },
      "fake": {
        "statePath": ".data/fake-ln.json"
      },
      "lockupTimeoutSeconds": 900,
      "sweepConcurrency": 8,
      "sendHintScidDenylist": [],
      "receiveAcceptUnilateralGap": false
    },
    "onchain": {
      "esploraUrl": "https://mempool.arkade.sh/api",
      "chainTipEsploraUrl": "https://mempool.arkade.sh/api",
      "feeRateRefreshMs": 60000,
      "feeRateStaleMs": 900000
    },
    "evm": {
      "arbitrum": {
        "chainId": 42161,
        "rpcUrl": "https://arb-mainnet.g.alchemy.com/v2/your-api-key",
        "htlcAddress": "0x1111111111111111111111111111111111111111",
        "privateKey": "<0x and 64 hex characters, kept apart from the mnemonic>",
        "minConfirmations": 12,
        "minAgeSeconds": 720,
        "fastestSecondsPerBlock": 0.25,
        "slowestSecondsPerBlock": 1,
        "timelockFastestSecondsPerBlock": 12,
        "timelockSlowestSecondsPerBlock": 24,
        "gasLimit": "300000",
        "maxFeePerGasCeiling": "5000000000",
        "feeHeadroomSeconds": 600,
        "orderMarginSeconds": 7200,
        "quoteValiditySeconds": 60,
        "logScanRange": 10000,
        "directClaimsOnly": false
      }
    }
  },
  "assets": {
    "USDC@arbitrum": {
      "kind": "erc20",
      "chain": "arbitrum",
      "address": "0xaf88d065e77c8cc2239327c5edb3a432268e5831",
      "decimals": 6,
      "priceFeed": "https://api.example.com/btc-usdc",
      "pricePath": "/price"
    },
    "USDA": {
      "kind": "arkade",
      "assetId": "41bcbb06921a0e9f6fe4f1b003b878cbb43d9ca3f6d14cab7940090458765a390000",
      "approvalThreshold": "250000000"
    }
  },
  "limits": {
    "maxSwapSats": 50000,
    "maxExposedSats": 150000,
    "approvalThresholdSats": 25000
  },
  "corridors": {
    "arkade:BTC->lightning:BTC": { "enabled": true, "minSats": 1000, "maxSats": 50000, "feeBps": 50, "feeFlatSats": 0 },
    "lightning:BTC->arkade:BTC": { "enabled": true, "minSats": 1000, "maxSats": 50000, "feeBps": 50, "feeFlatSats": 0 },
    "arkade:BTC->onchain:BTC": {
      "enabled": true,
      "minSats": 10000,
      "maxSats": 50000,
      "feeBps": 30,
      "feeFlatSats": 1500,
      "feeCapSats": 20000,
      "feeMinSats": 500
    },
    "arkade:BTC->USDC@arbitrum": {
      "enabled": true,
      "minSats": 10000,
      "maxSats": 50000,
      "feeBps": 40,
      "feeFlatSats": 0,
      "minUnits": "1000000",
      "maxUnits": "1000000000"
    },
    "USDC@arbitrum->arkade:BTC": {
      "enabled": true,
      "minSats": 10000,
      "maxSats": 50000,
      "feeBps": 40,
      "feeFlatSats": 0,
      "minUnits": "1000000",
      "maxUnits": "1000000000"
    },
    "arkade:BTC->USDA": { "enabled": true },
    "USDA->arkade:BTC": { "enabled": true }
  },
  "offers": {
    "markets": ["BTC/USDA"],
    "minFillAmount": "1000",
    "maxFillAmount": "500000000",
    "chargeCarrier": false,
    "carrierPricing": false,
    "quoteValiditySeconds": 30
  },
  "relay": {
    "url": "wss://relay.example.com",
    "protocol": "nostr",
    "healthPath": ".data/relay-health",
    "openRfqMaxBidsPerMinute": 30,
    "adPublish": "manual",
    "cardRelays": ["wss://relay.damus.io"]
  },
  "storage": {
    "dir": ".data",
    "swapDb": ".data/swaps.sqlite",
    "arkDb": ".data/ark.sqlite"
  },
  "http": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "admin": {
    "host": "127.0.0.1",
    "port": 8788,
    "restartEnabled": false
  },
  "sentry": {
    "dsn": "<https://public-key@o0.ingest.sentry.io/project-id>",
    "environment": "bitcoin",
    "release": "0.3.2"
  },
  "notify": {
    "telegramBotToken": "<token from @BotFather>",
    "telegramChatId": "-1001234567890",
    "slackWebhookUrl": "<https://hooks.slack.com/services/...>",
    "balanceReportIntervalMinutes": 360
  },
  "diagnostics": {
    "latency": false
  }
}
